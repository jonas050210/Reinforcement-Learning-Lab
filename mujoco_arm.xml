<mujoco model="wheel_arm_rl">
  <compiler angle="radian" coordinate="local"/>
  <default>
    <joint damping="1" armature="0.01"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.5 0.1 0.1"/>
  </default>

  <option timestep="0.01" gravity="0 0 -9.81" iterations="50"/>

  <worldbody>
    <!-- Boden -->
    <geom name="floor" type="plane" size="0 0 1" rgba="0.85 0.85 0.85 1"/>

    <!-- Roboter Basis (fahrbar auf X/Y = Räder) -->
    <body name="base" pos="0 0 0.1">
      <joint name="base_x" type="slide" axis="1 0 0" limited="true" range="-1.5 1.5"/>
      <joint name="base_y" type="slide" axis="0 1 0" limited="true" range="-1.5 1.5"/>
      <geom name="base_geom" type="box" size="0.2 0.12 0.05" rgba="0.2 0.5 0.8 1"/>

      <!-- Arm Gelenk 1: Basis-Rotation um Z -->
      <body name="arm1" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" limited="true" range="-1.57 1.57"/>
        <geom name="arm1_geom" type="capsule" size="0.03 0.1" pos="0 0 0.05" euler="0 1.57 0" rgba="0.85 0.3 0.3 1"/>

        <!-- Arm Gelenk 2: Schulter -->
        <body name="arm2" pos="0 0 0.2">
          <joint name="j2" type="hinge" axis="0 1 0" limited="true" range="-1.57 1.57"/>
          <geom name="arm2_geom" type="capsule" size="0.025 0.15" pos="0 0 0.075" euler="0 0 1.57" rgba="0.85 0.5 0.2 1"/>

          <!-- Arm Gelenk 3: Ellenbogen -->
          <body name="arm3" pos="0 0 0.15">
            <joint name="j3" type="hinge" axis="0 1 0" limited="true" range="-1.57 1.57"/>
            <geom name="arm3_geom" type="capsule" size="0.02 0.1" pos="0 0 0.05" euler="0 0 1.57" rgba="0.85 0.85 0.2 1"/>

            <!-- Greifer (vereinfacht als Box mit Tip-Site) -->
            <body name="gripper" pos="0 0 0.1">
              <geom name="gripper_geom" type="box" size="0.015 0.015 0.02" rgba="0.3 0.8 0.3 1"/>
              <site name="gripper_tip" pos="0 0 -0.02" size="0.008" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Ziel-Würfel (frei beweglich, damit der Arm ihn greifen kann) -->
    <body name="cube" pos="0.6 0.2 0.025">
      <joint name="cube_joint" type="free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" rgba="1 0.5 0 1" mass="0.1"/>
    </body>

    <!-- Box / Zielzone (transparent, Markierung) -->
    <geom name="target_box" type="box" size="0.12 0.12 0.01" pos="0.3 0.0 0.005" rgba="0.5 0.5 0.5 0.3"/>
    <site name="target_center" pos="0.3 0.0 0.015" size="0.005" rgba="0 1 0 1"/>
  </worldbody>

  <actuator>
    <motor name="motor_base_x" joint="base_x" gear="10"/>
    <motor name="motor_base_y" joint="base_y" gear="10"/>
    <motor name="motor_j1" joint="j1" gear="50"/>
    <motor name="motor_j2" joint="j2" gear="50"/>
    <motor name="motor_j3" joint="j3" gear="50"/>
  </actuator>
</mujoco>
