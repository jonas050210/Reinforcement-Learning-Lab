<mujoco model="wheel_arm_rl_ubuntu">
  <compiler angle="radian" coordinate="local"/>
  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.1 0.1"/>
  </default>

  <option timestep="0.005" gravity="0 0 -9.81" iterations="50" solver="CG"/>

  <worldbody>
    <!-- Beleuchtung: Blender-Style 3-Point-Lighting -->
    <light name="light_key" pos="2 2 4" dir="-2 -2 -4" directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light name="light_fill" pos="-2 2 3" dir="2 -2 -3" directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <light name="light_back" pos="0 -2 3" dir="0 2 -3" directional="true" diffuse="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>

    <!-- Standard-Kamera für Blender-Style Ansicht -->
    <camera name="blender_cam" pos="1.5 1.5 1.5" xyaxes="0.707 -0.707 0 0.408 0.408 -0.816" fovy="45"/>
    <!-- Boden mit Schachbrett-Muster für bessere Orientierung -->
    <geom name="floor" type="plane" size="0 0 1" rgba="0.85 0.85 0.85 1"/>

    <!-- Gitter-Linien auf dem Boden (visuelle Referenz) -->
    <geom name="grid_x1" type="plane" size="5 0.01 1" pos="0 0 0.001" rgba="0.6 0.6 0.6 0.5" euler="0 0 0"/>
    <geom name="grid_y1" type="plane" size="0.01 5 1" pos="0 0 0.001" rgba="0.6 0.6 0.6 0.5" euler="0 0 0"/>

    <!-- Roboter Basis (fahrbar auf X/Y = Räder) -->
    <body name="base" pos="0 0 0.12">
      <joint name="base_x" type="slide" axis="1 0 0" limited="true" range="-2.5 2.5"/>
      <joint name="base_y" type="slide" axis="0 1 0" limited="true" range="-2.5 2.5"/>
      <geom name="base_geom" type="box" size="0.28 0.16 0.07" rgba="0.2 0.5 0.8 1"/>

      <!-- Arm Gelenk 1: Basis-Rotation um Z -->
      <body name="arm1" pos="0 0 0.14">
        <joint name="j1" type="hinge" axis="0 0 1" limited="true" range="-2.0 2.0"/>
        <geom name="arm1_geom" type="capsule" size="0.035 0.12" pos="0 0 0.06" euler="0 1.57 0" rgba="0.85 0.3 0.3 1"/>

        <!-- Arm Gelenk 2: Schulter -->
        <body name="arm2" pos="0 0 0.24">
          <joint name="j2" type="hinge" axis="0 1 0" limited="true" range="-2.0 2.0"/>
          <geom name="arm2_geom" type="capsule" size="0.03 0.18" pos="0 0 0.09" euler="0 0 1.57" rgba="0.85 0.5 0.2 1"/>

          <!-- Arm Gelenk 3: Ellenbogen -->
          <body name="arm3" pos="0 0 0.18">
            <joint name="j3" type="hinge" axis="0 1 0" limited="true" range="-2.0 2.0"/>
            <geom name="arm3_geom" type="capsule" size="0.025 0.12" pos="0 0 0.06" euler="0 0 1.57" rgba="0.85 0.85 0.2 1"/>

            <!-- Greifer mit Site für Präzision -->
            <body name="gripper" pos="0 0 0.12">
              <geom name="gripper_geom" type="box" size="0.018 0.018 0.024" rgba="0.3 0.8 0.3 1"/>
              <site name="gripper_tip" pos="0 0 -0.025" size="0.006" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Ziel-Würfel (frei beweglich) -->
    <body name="cube" pos="0.7 0.3 0.025">
      <joint name="cube_joint" type="free"/>
      <geom name="cube_geom" type="box" size="0.03 0.03 0.03" rgba="1 0.5 0 1" mass="0.15"/>
    </body>

    <!-- Box / Zielzone (groß, deutlich sichtbar) -->
    <geom name="target_box" type="box" size="0.15 0.15 0.015" pos="0.7 -0.5 0.007" rgba="0.5 0.5 0.5 0.4"/>
    <site name="target_center" pos="0.7 -0.5 0.022" size="0.006" rgba="0 1 0 1"/>

    <!-- Optional: Zweites Objekt für späteres Curriculum -->
    <body name="cube2" pos="2.0 2.0 0.025">
      <joint name="cube2_joint" type="free"/>
      <geom name="cube2_geom" type="box" size="0.03 0.03 0.03" rgba="0.2 0.6 1 1" mass="0.15"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_base_x" joint="base_x" gear="20"/>
    <motor name="motor_base_y" joint="base_y" gear="20"/>
    <motor name="motor_j1" joint="j1" gear="80"/>
    <motor name="motor_j2" joint="j2" gear="80"/>
    <motor name="motor_j3" joint="j3" gear="80"/>
  </actuator>
</mujoco>
